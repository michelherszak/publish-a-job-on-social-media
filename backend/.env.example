# Copy to backend/.env.local; never commit or paste real secrets into chat.
# Environment values are loaded by your deployment service or the documented shell command.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_SCALE_YEARLY=
STRIPE_PRICE_TOKENS_250=
STRIPE_PRICE_TOKENS_1000=
STRIPE_PRICE_TOKENS_2500=
MH_PUBLIC_URL=http://127.0.0.1:5181
MH_DEMO_SWITCHER=1
# Keep all live gates disabled during development.
MH_STRIPE_LIVE_ENABLED=0
MH_EU_RADAR_CONFIRMED=0
MH_STRIPE_TAX_READY=0
# The current product uses local content templates, not real AI.
# Enable only once the delivered paid features match the customer-facing offer.
MH_PAID_PRODUCT_READY=0
# Only after Stripe invoice template, seller details, tax ID, PDF consent/e-invoice process and test invoice are checked.
MH_INVOICE_READY=0

# Local authentication and invoice messages are private .eml files in backend/mail_outbox.
MH_ENV=development
MH_MAIL_MODE=local
# Production: HTTPS, SMTP with STARTTLS, stable Fernet key, demo switcher disabled.
MH_AUTH_ENCRYPTION_KEY=
MH_MAIL_FROM=
MH_SMTP_HOST=
MH_SMTP_PORT=587
MH_SMTP_USER=
MH_SMTP_PASSWORD=

# Facebook Page publishing: one operator-owned Meta app; each company connects its own Page.
# See META_SETUP.md. Keep secrets exclusively on the server.
# The actual Graph version is selected from the Meta app dashboard, not guessed here.
MH_META_APP_ID=
MH_META_APP_SECRET=
MH_META_GRAPH_VERSION=
MH_META_CALLBACK_URL=
